<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>5.4.9</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CSweet.Agent.SDK" Version="5.7.1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.15.0" />
    <PackageReference Include="Microsoft.Agents.AI.Tools.Shell" Version="1.15.0-preview.260722.1" />
    <InternalsVisibleTo Include="CSweet.Agent.QA.VideoGame.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <Content Include="..\..\csweet-plugin.json" Link="csweet-plugin.json" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="content\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../extensions/video-game/*.cs" Link="Extension/%(Filename)%(Extension)" />
    <EmbeddedResource Include="qa-interactions.cjs" />
    <EmbeddedResource Include="qa-interactions.py" />
    <EmbeddedResource Include="qa-request-policy.cjs" />
  </ItemGroup>
</Project>
